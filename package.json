{
  "name": "sci-test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bank:prepare": "node scripts/prepare-science-bank.mjs",
    "bank:inspect": "node scripts/import-science-bank.mjs implementation/local/question-bank/candidate.json",
    "bank:test": "node --test scripts/lib/science-bank.test.mjs",
    "deployment:check": "node scripts/check-science-deployment.mjs",
    "questions:gaps": "node scripts/pipeline/report-subdomain-gaps.mjs",
    "questions:plan": "node scripts/pipeline/plan-subdomain-batch.mjs",
    "questions:validate": "node scripts/pipeline/validate-batch.mjs",
    "questions:merge": "node scripts/pipeline/merge-batch.mjs",
    "questions:build": "SCIENCE_BUILD_QUESTION_BANK=1 vitest run src/lib/data/knowledgeBank.build.test.ts",
    "questions:audit": "node scripts/audit-choice-plausibility.mjs",
    "questions:calibrate": "node scripts/calibrate-question-levels.mjs",
    "questions:distribution": "node scripts/report-question-level-distribution.mjs",
    "questions:import": "node scripts/import-question-bank.mjs supabase/seed/generated/questions-knowledge.json --published",
    "questions:check": "node scripts/pipeline/ci-question-checks.mjs",
    "questions:report": "node scripts/pipeline/scheduled-audit.mjs",
    "questions:pipeline": "pnpm questions:validate && pnpm questions:build && pnpm questions:audit -- --strict && pnpm questions:gaps && pnpm questions:check",
    "preflight": "node scripts/preflight.mjs && node scripts/check-science-deployment.mjs",
    "security:check": "node scripts/check-security-env.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.24",
    "nodemailer": "^10.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.24",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.7.0"
}
