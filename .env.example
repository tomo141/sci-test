NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# New administrator membership is stored in science_admins, not an email allowlist.
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional legacy Redis configuration. New science APIs use the shared DB rate limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to 1 to require Turnstile in the environment preflight.
SECURITY_STRICT=

# Server-only bearer token (32+ random characters) for scheduled jobs
CRON_SECRET=

# Optional SMTP marketing delivery. Keep science_config.release.mailDelivery=false until verified.
# Supabase Auth OTP has separate SMTP settings in the Supabase dashboard.
SCIENCE_MAIL_ORIGIN=https://sci-test.rikei-talk.com
SCIENCE_MAIL_FROM=
# Reviewed sender identification/contact footer, including required operator details.
SCIENCE_MAIL_FOOTER=
SCIENCE_MAIL_UNSUBSCRIBE_SECRET=
SCIENCE_SMTP_HOST=
SCIENCE_SMTP_PORT=587
SCIENCE_SMTP_USER=
SCIENCE_SMTP_PASSWORD=
