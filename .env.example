NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# New administrator membership is stored in science_admins, not an email allowlist.
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional legacy Redis configuration. New science APIs use the shared DB rate limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to 1 to require Turnstile in the environment preflight.
SECURITY_STRICT=

# Server-only bearer token (32+ random characters) for scheduled jobs
CRON_SECRET=

# Guidance is managed in MyASP. Supabase Auth OTP uses Resend's SMTP settings in its dashboard.
# Keep science_config.release.myaspSync/mailDelivery=false until the live connection and mail rules are verified.
SCIENCE_MAIL_ORIGIN=https://sci-test.rikei-talk.com
SCIENCE_MYASP_MCP_URL=
SCIENCE_MYASP_SERVER_URL=https://email.rikei-talk.com
SCIENCE_MYASP_API_KEY=
SCIENCE_MYASP_SCENARIO_ID=wTYCnyFi
